{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true
	},
	"include": ["scripts/**/*.ts", "src/**/*.ts", "src/**/*.vue", "vite.config.ts"],
	"exclude": ["node_modules", "dist", ".ssr"]
}
